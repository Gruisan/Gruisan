{
  "name": "magasin3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Magasin 3D — Digital Stock : visualisation et gestion d'un magasin de pièces industrielles (démo locale, fichier HTML autonome).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:demo": "vite-node scripts/generate-demo.ts",
    "e2e": "node scripts/e2e-file.mjs",
    "generate:xlsx": "vite-node scripts/generate-xlsx.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "xlsx": "0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "1.56",
    "postcss": "^8.5.30",
    "stats.js": "^0.17.0",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9",
    "vite": "6.4",
    "vite-node": "3.2",
    "vite-plugin-singlefile": "2.3",
    "vitest": "3.2"
  }
}
